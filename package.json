{
  "name": "pi-codemode-snippets",
  "version": "0.2.2",
  "type": "module",
  "description": "Pi extension that turns user-authored `.js` codemode snippets (a `// @snippet:` pragma plus a sandbox script) into first-class pi tools the model, other tools, and codemode scripts can call.",
  "main": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./pragma": "./src/pragma.ts",
    "./snippet": "./src/snippet.ts",
    "./codegen": "./src/codegen.ts",
    "./execute": "./src/execute.ts",
    "./tool": "./src/tool.ts",
    "./commands": "./src/commands.ts",
    "./types": "./src/types.ts"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi-skill",
    "codemode",
    "snippets",
    "tools",
    "llm",
    "ai-agent",
    "agentic-coding",
    "tool-calling",
    "quickjs",
    "sandbox",
    "pi",
    "pi-coding-agent",
    "ai-coding",
    "developer-tools",
    "cli-snippets",
    "tool-registry",
    "script-to-tool",
    "composition",
    "idempotent",
    "json-schema",
    "typescript",
    "mcp"
  ],
  "author": "Jiajun Chen <tychenjiajun@live.cn>",
  "license": "MIT",
  "homepage": "https://pi.dev/packages/pi-codemode-snippets",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tychenjiajun/pi-codemode-snippets.git"
  },
  "bugs": {
    "url": "https://github.com/tychenjiajun/pi-codemode-snippets/issues"
  },
  "sideEffects": false,
  "files": [
    "src/**/*.ts",
    "!src/**/*.test.ts",
    "skills/**",
    "examples/**",
    "README.md",
    "assets/**",
    "DESIGN.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ],
    "image": "https://raw.githubusercontent.com/tychenjiajun/pi-codemode-snippets/main/assets/preview.png",
    "video": "https://raw.githubusercontent.com/tychenjiajun/pi-codemode-snippets/main/assets/demo.mp4",
    "skills": [
      "./skills"
    ]
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^1.4.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  },
  "packageManager": "pnpm@12.6.0"
}
